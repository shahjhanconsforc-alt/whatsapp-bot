PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=whatsapp_db
PGUSER=postgres
PGPASSWORD=CHANGE_ME



# Playwright runtime (production/local)
# false = visible browser tab, true = headless (no visible tab)
# Single-profile mode
PLAYWRIGHT_USER_DATA_DIR=./playwright_profile

# Multi-account profile mode
# true = use profiles under PLAYWRIGHT_PROFILES_ROOT and auto-pick current/last-used profile
PLAYWRIGHT_MULTI_ACCOUNT=true
PLAYWRIGHT_PROFILES_ROOT=./playwright_profiles
PLAYWRIGHT_PROFILE_NAME=default
PLAYWRIGHT_PROFILE_AUTO_SELECT=true

PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_START_MAXIMIZED=true
PLAYWRIGHT_NO_VIEWPORT=true
PLAYWRIGHT_SLOW_MO_MS=0

# Viewing the automation windows after Docker deployment (xvfb mode):
# Chromium runs headed on a virtual display inside the container and x11vnc
# shares it. Connect a VNC viewer to <server-ip>:5900. Set a password!
VNC_ENABLED=true
VNC_PASSWORD=CHANGE_ME
VNC_PORT=5900
XVFB_SCREEN=1440x900x24
